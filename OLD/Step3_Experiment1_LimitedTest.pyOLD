def plan() -> None:
    write_task_map()
    print("=" * 120)
    print("STEP 3 — EXPERIMENT 1 PLAN")
    print("=" * 120)
    print("4 datasets x 11 models = 44 jobs")
    print("One fixed split; no cross-validation.")
    print()
    print(f"{'ID':>3}  {'DATASET':16s}  {'MODEL':30s}  FAMILY")
    print("-" * 90)
    for task in all_tasks():
        family = "AUTHOR" if task["model"] in AUTHOR_MODELS else "OURS"
        print(
            f"{task['task_id']:3d}  {task['dataset']:16s}  "
            f"{task['model']:30s}  {family}"
        )


def _metric_table_from_done(records: List[Dict]) -> pd.DataFrame:
    frames = []

    for rec in records:
        ext_path = rec.get("extended_metrics_csv")
        pkg_path = rec.get("stable_package_metrics") or rec.get("metrics_csv")

        if ext_path and Path(ext_path).is_file():
            df = pd.read_csv(ext_path)
            df.insert(0, "Model", rec["model"])
            df.insert(0, "Dataset", rec["dataset"])
            df.insert(0, "TaskID", rec["task_id"])
            frames.append(df)
            continue

        if pkg_path and Path(pkg_path).is_file():
            df = pd.read_csv(pkg_path)
            df.insert(0, "Model", rec["model"])
            df.insert(0, "Dataset", rec["dataset"])
            df.insert(0, "TaskID", rec["task_id"])
            frames.append(df)

    if not frames:
        return pd.DataFrame()
    return pd.concat(frames, ignore_index=True, sort=False)


def _format_metric_table(df: pd.DataFrame) -> str:
    if df.empty:
        return "No completed metrics yet."

    # Prefer the requested regression metrics while retaining target information.
    preferred = [
        "TaskID", "Dataset", "Model", "Target",
        "N", "ME", "MAE", "MSE", "RMSE", "MedAE",
        "MPE_pct", "MAPE_pct", "RMSPE_pct",
        "R2", "Pearson", "Spearman", "Bias",
    ]

    cols = [c for c in preferred if c in df.columns]

    # If extended metrics were unavailable, show all package metric columns.
    if len(cols) <= 3:
        cols = list(df.columns)

    out = df[cols].copy()

    for c in out.columns:
        if pd.api.types.is_numeric_dtype(out[c]):
            out[c] = out[c].map(
                lambda x: f"{x:.5g}" if pd.notna(x) else "NA"
            )

    return out.to_string(index=False)


def _safe_float(value):
    try:
        return float(value)
    except Exception:
        return None


def _fmt_number(value, digits=4):
    if value is None:
        return "-"
    try:
        value = float(value)
    except Exception:
        return str(value)

    if not math.isfinite(value):
        return "-"

    if abs(value) >= 1000:
        return f"{value:.2e}"

    return f"{value:.{digits}f}"


def _fmt_seconds(seconds):
    if seconds is None:
        return "-"

    try:
        seconds = float(seconds)
    except Exception:
        return "-"

    if not math.isfinite(seconds):
        return "-"

    if seconds < 60:
        return f"{seconds:.1f}s"

    minutes = seconds / 60.0

    if minutes < 60:
        return f"{minutes:.1f}m"

    hours = minutes / 60.0

    return f"{hours:.2f}h"


def _slurm_task_status():
    """
    Current Slurm state indexed by array task ID.

    IMPORTANT:
    Read ONLY the most recently submitted Step-3 array.

    `squeue -r` expands an array into individual tasks, avoiding the
    compressed-array-ID problem where entries such as 0-43 cannot be parsed
    as integer task IDs.
    """

    info = {}

    submission_file = (
        STATE
        / "last_submission.json"
    )

    if not submission_file.is_file():
        return info

    try:

        submission = json.loads(
            submission_file.read_text()
        )

        job_id = str(
            submission["job_id"]
        )

    except Exception:
        return info

    try:

        result = subprocess.run(
            [
                "squeue",
                "-r",
                "-h",
                "-j",
                job_id,
                "-o",
                "%A|%a|%T|%M|%N",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )

    except Exception:
        return info

    for line in result.stdout.splitlines():

        fields = line.strip().split(
            "|"
        )

        if len(fields) != 5:
            continue

        master_id = fields[0]
        array_id = fields[1]
        state = fields[2]
        elapsed = fields[3]
        node = fields[4]

        try:
            task_id = int(
                array_id
            )

        except Exception:
            continue

        info[
            task_id
        ] = {
            "job_id":
                master_id,

            "state":
                state.upper(),

            "elapsed":
                elapsed,

            "node":
                node,
        }

    return info


def _latest_task_log(task_id, slurm_info=None):
    """
    Find the newest stdout log for one array task.

    Prefer the current active Slurm job ID so old logs from an earlier
    submission cannot contaminate the live dashboard.
    """

    if not LOGS.exists():
        return None

    candidates = []

    if slurm_info:
        job_id = slurm_info.get("job_id")

        if job_id:
            candidates.extend(
                LOGS.glob(
                    f"*.{job_id}_{task_id}.out"
                )
            )

    if not candidates:

        submission_file = (
            STATE
            / "last_submission.json"
        )

        if submission_file.is_file():

            try:

                submission = json.loads(
                    submission_file.read_text()
                )

                current_job = str(
                    submission[
                        "job_id"
                    ]
                )

                candidates.extend(
                    LOGS.glob(
                        f"*.{current_job}_{task_id}.out"
                    )
                )

            except Exception:
                pass

    # We intentionally DO NOT fall back to arbitrary old array logs here.
    # Otherwise an old failed/completed task can contaminate a fresh run.

    candidates = [
        x for x in candidates
        if x.is_file()
    ]

    if not candidates:
        return None

    return max(
        candidates,
        key=lambda x: x.stat().st_mtime,
    )


def _read_log_tail(path, max_bytes=2_000_000):

    if path is None:
        return ""

    try:
        size = path.stat().st_size

        with path.open(
            "rb"
        ) as handle:

            if size > max_bytes:
                handle.seek(
                    size - max_bytes
                )

            raw = handle.read()

        text = raw.decode(
            "utf-8",
            errors="replace",
        )

        # Remove ANSI colour/control sequences.
        text = re.sub(
            r"\x1b\[[0-9;]*[A-Za-z]",
            "",
            text,
        )

        return text

    except Exception:
        return ""


def _parse_elapsed_seconds(value):
    """
    Convert Slurm elapsed strings such as:
        21:43
        01:21:43
        1-02:03:04
    into seconds.
    """

    if not value:
        return None

    try:

        days = 0

        if "-" in value:
            day_text, value = value.split(
                "-",
                1,
            )
            days = int(day_text)

        pieces = [
            int(x)
            for x in value.split(":")
        ]

        if len(pieces) == 2:
            hours = 0
            minutes, seconds = pieces

        elif len(pieces) == 3:
            hours, minutes, seconds = pieces

        else:
            return None

        return (
            days * 86400
            +
            hours * 3600
            +
            minutes * 60
            +
            seconds
        )

    except Exception:
        return None


def _parse_training_log(text):
    """
    Parse the epoch lines emitted by the common PhyloGNN trainer.

    Example:
        Epoch  12/1000
        train loss 14.22
        validation loss 15.91
        mae 0.41/0.46
        best epoch 11
    """

    info = {
        "epoch": None,
        "total_epochs": None,
        "train_loss": None,
        "val_loss": None,
        "metric_name": None,
        "train_metric": None,
        "val_metric": None,
        "best_epoch": None,
        "mean_sec_epoch": None,
        "train_seconds": None,
        "final_metric_name": None,
        "final_metric": None,
    }

    if not text:
        return info

    epoch_pattern = re.compile(
        r"""
        \[
        (?P<timestamp>\d{2}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})
        \]
        .*?
        Epoch\s+
        (?P<epoch>\d+)
        /
        (?P<total>\d+)
        \s+
        train\s+loss\s+
        (?P<train_loss>[-+0-9.eE]+)
        \s+
        validation\s+loss\s+
        (?P<val_loss>[-+0-9.eE]+)
        \s+
        (?P<metric>[A-Za-z0-9_%.-]+)
        \s+
        (?P<train_metric>[-+0-9.eE]+)
        /
        (?P<val_metric>[-+0-9.eE]+)
        \s+
        best\s+epoch\s+
        (?P<best_epoch>\d+)
        """,
        re.VERBOSE,
    )

    matches = list(
        epoch_pattern.finditer(
            text
        )
    )

    if matches:

        last = matches[-1]

        info["epoch"] = int(
            last.group("epoch")
        )

        info["total_epochs"] = int(
            last.group("total")
        )

        info["train_loss"] = _safe_float(
            last.group("train_loss")
        )

        info["val_loss"] = _safe_float(
            last.group("val_loss")
        )

        info["metric_name"] = (
            last.group("metric")
        )

        info["train_metric"] = _safe_float(
            last.group("train_metric")
        )

        info["val_metric"] = _safe_float(
            last.group("val_metric")
        )

        info["best_epoch"] = int(
            last.group("best_epoch")
        )

        # -------------------------------------------------------------
        # Mean time per epoch from epoch timestamps.
        # -------------------------------------------------------------

        timestamps = []

        for match in matches:

            try:

                timestamp = datetime.strptime(
                    match.group("timestamp"),
                    "%m/%d/%y %H:%M:%S",
                )

                timestamps.append(
                    (
                        int(
                            match.group("epoch")
                        ),
                        timestamp,
                    )
                )

            except Exception:
                pass

        if len(timestamps) >= 2:

            first_epoch, first_time = timestamps[0]
            last_epoch, last_time = timestamps[-1]

            epoch_difference = (
                last_epoch
                -
                first_epoch
            )

            if epoch_difference > 0:

                seconds = (
                    last_time
                    -
                    first_time
                ).total_seconds()

                info["mean_sec_epoch"] = (
                    seconds
                    /
                    epoch_difference
                )

    # -----------------------------------------------------------------
    # Parse final trainer summary if training has finished.
    # -----------------------------------------------------------------

    done_pattern = re.compile(
        r"""
        done:
        \s*
        (?P<metric>[A-Za-z0-9_%.-]+)
        \s*=\s*
        (?P<value>[-+0-9.eE]+)
        \s*
        \(
        train\s+
        (?P<seconds>[-+0-9.eE]+)
        s,
        \s*
        best\s+epoch\s+
        (?P<best_epoch>\d+)
        \)
        """,
        re.VERBOSE,
    )

    done_matches = list(
        done_pattern.finditer(
            text
        )
    )

    if done_matches:

        match = done_matches[-1]

        info["final_metric_name"] = (
            match.group("metric")
        )

        info["final_metric"] = _safe_float(
            match.group("value")
        )

        info["train_seconds"] = _safe_float(
            match.group("seconds")
        )

        info["best_epoch"] = int(
            match.group("best_epoch")
        )

        if (
            info["train_seconds"] is not None
            and
            info["epoch"]
        ):

            info["mean_sec_epoch"] = (
                info["train_seconds"]
                /
                info["epoch"]
            )

    return info


def _task_dashboard_record(
    task,
    slurm_map,
):
    """
    Build one live status record.
    """

    task_id = task["task_id"]

    slurm = slurm_map.get(
        task_id,
        {}
    )

    done = done_marker(
        task
    ).is_file()

    failed = failed_marker(
        task
    ).is_file()

    active_state = slurm.get(
        "state"
    )

    if done:
        state = "DONE"

    elif active_state:
        state = active_state

    elif failed:
        state = "FAILED"

    else:
        state = "WAIT"

    log_file = _latest_task_log(
        task_id,
        slurm,
    )

    log_text = _read_log_tail(
        log_file
    )

    training = _parse_training_log(
        log_text
    )

    epoch = training[
        "epoch"
    ]

    total_epochs = training[
        "total_epochs"
    ]

    progress = None

    if (
        epoch is not None
        and
        total_epochs
    ):

        progress = (
            100.0
            *
            epoch
            /
            total_epochs
        )

    mean_sec_epoch = training[
        "mean_sec_epoch"
    ]

    eta_seconds = None

    if (
        mean_sec_epoch is not None
        and
        epoch is not None
        and
        total_epochs is not None
        and
        total_epochs >= epoch
    ):

        eta_seconds = (
            total_epochs
            -
            epoch
        ) * mean_sec_epoch

    return {
        "task_id":
            task_id,

        "dataset":
            task["dataset"],

        "model":
            task["model"],

        "state":
            state,

        "epoch":
            epoch,

        "total_epochs":
            total_epochs,

        "progress":
            progress,

        "train_loss":
            training["train_loss"],

        "val_loss":
            training["val_loss"],

        "metric_name":
            training["metric_name"],

        "train_metric":
            training["train_metric"],

        "val_metric":
            training["val_metric"],

        "best_epoch":
            training["best_epoch"],

        "elapsed":
            slurm.get(
                "elapsed",
                "-"
            ),

        "elapsed_seconds":
            _parse_elapsed_seconds(
                slurm.get(
                    "elapsed"
                )
            ),

        "mean_sec_epoch":
            mean_sec_epoch,

        "eta_seconds":
            eta_seconds,

        "final_metric_name":
            training["final_metric_name"],

        "final_metric":
            training["final_metric"],

        "log":
            str(log_file)
            if log_file
            else None,
    }


def _short_model_name(name):

    aliases = {
        "author_phylocnn_2gen":
            "PhyloCNN-2G",

        "author_phylocnn_1gen":
            "PhyloCNN-1G",

        "author_phylocnn_nocontext":
            "PhyloCNN-NC",

        "graphsage":
            "GraphSAGE",

        "gat":
            "GAT",

        "gcn":
            "GCN",

        "gin":
            "GIN",

        "ecc":
            "ECC",

        "trignn":
            "TriGNN",

        "gnn_fusion":
            "GNN-Fusion",

        "graphsage_gat_fusion":
            "SAGE-GAT",
    }

    return aliases.get(
        name,
        name,
    )


def _status_once():

    ensure_project_layout()
    write_task_map()

    slurm_map = _slurm_task_status()

    rows = [
        _task_dashboard_record(
            task,
            slurm_map,
        )
        for task in all_tasks()
    ]

    completed_records = []

    for task in all_tasks():

        marker = done_marker(
            task
        )

        if marker.is_file():

            try:
                completed_records.append(
                    json.loads(
                        marker.read_text()
                    )
                )
            except Exception:
                pass

    # =====================================================================
    # OVERALL SUMMARY
    # =====================================================================

    states = {}

    for row in rows:

        state = row["state"]

        states[state] = (
            states.get(
                state,
                0,
            )
            +
            1
        )

    n_done = sum(
        row["state"] == "DONE"
        for row in rows
    )

    n_failed = sum(
        row["state"] == "FAILED"
        for row in rows
    )

    n_running = sum(
        row["state"] == "RUNNING"
        for row in rows
    )

    n_pending = sum(
        row["state"] in {
            "PENDING",
            "CONFIGURING",
        }
        for row in rows
    )

    print(
        "=" * 190
    )

    print(
        "PHYLOGNN EXPERIMENT 1 — LIVE TRAINING DASHBOARD"
    )

    print(
        "=" * 190
    )

    print(
        f"Completed: {n_done:2d}/44   "
        f"Running: {n_running:2d}   "
        f"Pending: {n_pending:2d}   "
        f"Failed: {n_failed:2d}"
    )

    if states:
        print(
            "States:",
            states,
        )

    print(
        "NOTE: This is a REGRESSION experiment. "
        "Classification accuracy is therefore N/A. "
        "Live optimisation metric shown below is normally MAE."
    )

    print()

    # =====================================================================
    # LIVE PER-TASK TABLE
    # =====================================================================

    header = (
        f"{'ID':>2} "
        f"{'DATASET':13} "
        f"{'MODEL':13} "
        f"{'STATE':11} "
        f"{'EPOCH':11} "
        f"{'PROG':>6} "
        f"{'TRAIN LOSS':>11} "
        f"{'VAL LOSS':>11} "
        f"{'TRAIN MET':>10} "
        f"{'VAL MET':>10} "
        f"{'BEST':>5} "
        f"{'ELAPSED':>9} "
        f"{'SEC/EP':>9} "
        f"{'ETA':>9} "
        f"{'FINAL':>12}"
    )

    print(
        header
    )

    print(
        "-" * len(header)
    )

    for row in rows:

        if (
            row["epoch"] is not None
            and
            row["total_epochs"] is not None
        ):

            epoch_text = (
                f"{row['epoch']}/"
                f"{row['total_epochs']}"
            )

        else:
            epoch_text = "-"

        progress_text = (
            f"{row['progress']:5.1f}%"
            if row["progress"] is not None
            else "-"
        )

        metric_train = _fmt_number(
            row["train_metric"]
        )

        metric_val = _fmt_number(
            row["val_metric"]
        )

        best = (
            str(
                row["best_epoch"]
            )
            if row["best_epoch"] is not None
            else "-"
        )

        sec_epoch = (
            _fmt_seconds(
                row["mean_sec_epoch"]
            )
        )

        eta = _fmt_seconds(
            row["eta_seconds"]
        )

        final_text = "-"

        if (
            row["final_metric_name"]
            and
            row["final_metric"] is not None
        ):

            final_text = (
                f"{row['final_metric_name']}="
                f"{_fmt_number(row['final_metric'])}"
            )

        print(
            f"{row['task_id']:2d} "
            f"{row['dataset'][:13]:13} "
            f"{_short_model_name(row['model'])[:13]:13} "
            f"{row['state'][:11]:11} "
            f"{epoch_text:11} "
            f"{progress_text:>6} "
            f"{_fmt_number(row['train_loss']):>11} "
            f"{_fmt_number(row['val_loss']):>11} "
            f"{metric_train:>10} "
            f"{metric_val:>10} "
            f"{best:>5} "
            f"{row['elapsed']:>9} "
            f"{sec_epoch:>9} "
            f"{eta:>9} "
            f"{final_text:>12}"
        )

    # =====================================================================
    # CURRENT MEANS
    # =====================================================================

    active_with_epochs = [
        row
        for row in rows
        if (
            row["state"] == "RUNNING"
            and
            row["epoch"] is not None
        )
    ]

    print()
    print(
        "=" * 190
    )

    print(
        "CURRENT MEANS ACROSS RUNNING MODELS"
    )

    print(
        "=" * 190
    )

    def mean_available(
        field
    ):

        values = [
            row[field]
            for row in active_with_epochs
            if row.get(field) is not None
        ]

        if not values:
            return None

        return float(
            np.mean(
                values
            )
        )

    mean_epoch = mean_available(
        "epoch"
    )

    mean_train_loss = mean_available(
        "train_loss"
    )

    mean_val_loss = mean_available(
        "val_loss"
    )

    mean_train_metric = mean_available(
        "train_metric"
    )

    mean_val_metric = mean_available(
        "val_metric"
    )

    mean_sec_epoch = mean_available(
        "mean_sec_epoch"
    )

    mean_progress = mean_available(
        "progress"
    )

    print(
        "Running models with epoch data :",
        len(
            active_with_epochs
        ),
    )

    print(
        "Mean current epoch             :",
        _fmt_number(
            mean_epoch,
            1,
        ),
    )

    print(
        "Mean progress                  :",
        (
            f"{mean_progress:.1f}%"
            if mean_progress is not None
            else "-"
        ),
    )

    print(
        "Mean training loss             :",
        _fmt_number(
            mean_train_loss
        ),
    )

    print(
        "Mean validation loss           :",
        _fmt_number(
            mean_val_loss
        ),
    )

    print(
        "Mean training MAE/metric       :",
        _fmt_number(
            mean_train_metric
        ),
    )

    print(
        "Mean validation MAE/metric     :",
        _fmt_number(
            mean_val_metric
        ),
    )

    print(
        "Mean time per epoch            :",
        _fmt_seconds(
            mean_sec_epoch
        ),
    )

    # =====================================================================
    # DATASET SUMMARY
    # =====================================================================

    print()
    print(
        "=" * 190
    )

    print(
        "DATASET PROGRESS"
    )

    print(
        "=" * 190
    )

    for dataset in DATASETS:

        subset = [
            row
            for row in rows
            if row["dataset"] == dataset
        ]

        done = sum(
            row["state"] == "DONE"
            for row in subset
        )

        failed = sum(
            row["state"] == "FAILED"
            for row in subset
        )

        running = sum(
            row["state"] == "RUNNING"
            for row in subset
        )

        pending = sum(
            row["state"] in {
                "PENDING",
                "CONFIGURING",
            }
            for row in subset
        )

        epoch_progress = [
            row["progress"]
            for row in subset
            if row["progress"] is not None
        ]

        mean_dataset_progress = (
            float(
                np.mean(
                    epoch_progress
                )
            )
            if epoch_progress
            else 0.0
        )

        width = 40

        filled = int(
            round(
                width
                *
                mean_dataset_progress
                /
                100.0
            )
        )

        filled = max(
            0,
            min(
                width,
                filled,
            ),
        )

        bar = (
            "#"
            *
            filled
            +
            "-"
            *
            (
                width
                -
                filled
            )
        )

        print(
            f"{dataset:16} "
            f"|{bar}| "
            f"epoch-progress={mean_dataset_progress:6.1f}%  "
            f"done={done:2d} "
            f"run={running:2d} "
            f"pend={pending:2d} "
            f"fail={failed:2d}"
        )

    # =====================================================================
    # SPLIT CONSISTENCY
    # =====================================================================

    print()
    print(
        "=" * 190
    )

    print(
        "SPLIT CONSISTENCY"
    )

    print(
        "=" * 190
    )

    for dataset in DATASETS:

        subset = [
            record
            for record in completed_records
            if record["dataset"] == dataset
        ]

        hashes = sorted(
            set(
                record.get(
                    "split_content_sha256"
                )
                for record in subset
                if record.get(
                    "split_content_sha256"
                )
            )
        )

        if not subset:

            print(
                f"{dataset:16}: "
                "no completed runs yet"
            )

            continue

        if len(hashes) == 1:

            counts = next(
                (
                    record.get(
                        "split_counts"
                    )
                    for record in subset
                    if record.get(
                        "split_counts"
                    )
                ),
                None,
            )

            print(
                f"{dataset:16}: PASS — "
                f"{hashes[0][:12]}... "
                f"{counts}"
            )

        elif len(hashes) == 0:

            print(
                f"{dataset:16}: "
                "split hash unavailable"
            )

        else:

            print(
                f"{dataset:16}: "
                "*** SPLIT MISMATCH *** "
                f"{len(hashes)} hashes"
            )

    # =====================================================================
    # FINAL METRICS AVAILABLE SO FAR
    # =====================================================================

    print()
    print(
        "=" * 190
    )

    print(
        "COMPLETED TEST-SET METRICS"
    )

    print(
        "=" * 190
    )

    metric_df = _metric_table_from_done(
        completed_records
    )

    print(
        _format_metric_table(
            metric_df
        )
    )

    if (
        not metric_df.empty
        and
        "MAE" in metric_df.columns
    ):

        print()
        print(
            "=" * 190
        )

        print(
            "BEST MEAN MAE SO FAR PER DATASET"
        )

        print(
            "=" * 190
        )

        temp = metric_df.copy()

        temp["MAE"] = pd.to_numeric(
            temp["MAE"],
            errors="coerce",
        )

        summary = (
            temp
            .groupby(
                [
                    "Dataset",
                    "Model",
                ],
                as_index=False,
            )["MAE"]
            .mean()
            .dropna()
            .sort_values(
                [
                    "Dataset",
                    "MAE",
                ]
            )
        )

        if not summary.empty:

            best = (
                summary
                .groupby(
                    "Dataset",
                    as_index=False,
                )
                .first()
            )

            print(
                best.to_string(
                    index=False
                )
            )

    return rows


def status() -> None:
    _status_once()


def watch_status(seconds=20):
    """
    Continuously refresh the live dashboard.

    Stop with Ctrl+C.
    """

    seconds = max(
        2,
        int(seconds),
    )

    try:

        while True:

            # Clear terminal.
            print(
                "\033[2J\033[H",
                end="",
                flush=True,
            )

            print(
                "Last refresh:",
                datetime.now()
                .astimezone()
                .isoformat(
                    timespec="seconds"
                ),
            )

            print(
                f"Refresh interval: {seconds}s   "
                "Stop: Ctrl+C"
            )

            print()

            rows = _status_once()

            done = sum(
                row["state"] == "DONE"
                for row in rows
            )

            failed = sum(
                row["state"] == "FAILED"
                for row in rows
            )

            active = sum(
                row["state"] in {
                    "RUNNING",
                    "PENDING",
                    "CONFIGURING",
                }
                for row in rows
            )

            if done == len(
                all_tasks()
            ):

                print()
                print(
                    "[COMPLETE] All 44 tasks finished."
                )

                break

            if (
                active == 0
                and
                done + failed
                ==
                len(
                    all_tasks()
                )
            ):

                print()
                print(
                    "[STOP] No active jobs remain."
                )

                break

            time.sleep(
                seconds
            )

    except KeyboardInterrupt:

        print()
        print(
            "[STOP] Dashboard closed. "
            "Training jobs continue running."
        )


# =============================================================================
# AGGREGATE
# =============================================================================

def aggregate() -> None:
    records = []
    package_frames = []
    extended_frames = []

    for task in all_tasks():
        marker = done_marker(task)
        if not marker.is_file():
            continue

        rec = json.loads(marker.read_text())
        records.append(rec)

        pkg = rec.get("stable_package_metrics") or rec.get("metrics_csv")
        if pkg and Path(pkg).is_file():
            df = pd.read_csv(pkg)
            df.insert(0, "Model", task["model"])
            df.insert(0, "Dataset", task["dataset"])
            df.insert(0, "TaskID", task["task_id"])
            package_frames.append(df)

        ext = rec.get("extended_metrics_csv")
        if ext and Path(ext).is_file():
            df = pd.read_csv(ext)
            df.insert(0, "Model", task["model"])
            df.insert(0, "Dataset", task["dataset"])
            df.insert(0, "TaskID", task["task_id"])
            extended_frames.append(df)

    RESULTS.mkdir(parents=True, exist_ok=True)

    pd.DataFrame(records).to_json(
        RESULTS / "Experiment1_RunManifest.json",
        orient="records",
        indent=2,
    )

    if package_frames:
        pd.concat(
            package_frames,
            ignore_index=True,
            sort=False,
        ).to_csv(
            RESULTS / "Experiment1_AllPackageMetrics.csv",
            index=False,
        )

    if extended_frames:
        pd.concat(
            extended_frames,
            ignore_index=True,
            sort=False,
        ).to_csv(
            RESULTS / "Experiment1_AllExtendedMetrics.csv",
            index=False,
        )

    print("=" * 120)
    print("AGGREGATION")
    print("=" * 120)
    print(f"Completed runs: {len(records)}/44")
    print("Output folder :", RESULTS)
    print("Manifest      :", RESULTS / "Experiment1_RunManifest.json")
    if package_frames:
        print("Package metrics:", RESULTS / "Experiment1_AllPackageMetrics.csv")
    if extended_frames:
        print("Extended metrics:", RESULTS / "Experiment1_AllExtendedMetrics.csv")


# =============================================================================
# SLURM
# =============================================================================


def reset_fresh_submission_state() -> None:
    """
    Reset ONLY execution-state files from previous Step-3 submissions.

    KEEP:
      - prepared graph caches
      - PhyloCNN encoding caches
      - historical timestamped training outputs

    REMOVE:
      - old done markers
      - old failed markers
      - old Slurm stdout/stderr logs
      - previous task map/submission marker

    This prevents an old successful/failed job from being counted as part
    of a new 44-model experiment.
    """

    print()
    print("=" * 120)
    print("RESETTING STEP-3 EXECUTION STATE")
    print("=" * 120)

    for directory in (
        STATE / "done",
        STATE / "failed",
        LOGS,
    ):

        if directory.exists():
            shutil.rmtree(directory)

        directory.mkdir(
            parents=True,
            exist_ok=True,
        )

        print("[RESET]", directory)

    for file_path in (
        STATE / "last_submission.json",
        TASK_MAP,
    ):

        if file_path.exists():
            file_path.unlink()
            print("[RESET]", file_path)

    print("[KEEP] graph / PhyloCNN caches")
    print("[KEEP] historical timestamped result directories")
    print()


def smoke_test_ecc() -> None:
    """
    Run ONE epoch of ECC on BD-shipped before submitting the full array.

    Why:
      ECC has previously failed on all four datasets.  A normal structural
      preflight only proves the model can import/build; it does not prove that
      a complete forward/backward/checkpoint cycle works.

    Therefore a fresh submission must prove one complete ECC epoch first.
    """

    global EPOCHS
    global PATIENCE
    global BATCH_SIZE

    task = get_task(7)

    smoke_root = (
        STATE
        / "preflight_smoke"
        / "ecc"
    )

    if smoke_root.exists():
        shutil.rmtree(smoke_root)

    smoke_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    original_epochs = EPOCHS
    original_patience = PATIENCE

    # BATCH_SIZE may or may not exist depending on Step-3 version.
    had_batch_size = "BATCH_SIZE" in globals()

    if had_batch_size:
        original_batch_size = BATCH_SIZE

    original_task_result_root = globals()[
        "task_result_root"
    ]

    try:

        EPOCHS = 1
        PATIENCE = 1

        if had_batch_size:
            BATCH_SIZE = min(
                int(original_batch_size),
                32,
            )

        # Isolate the smoke result completely from real Experiment-1 outputs.
        globals()["task_result_root"] = (
            lambda _task:
                smoke_root
        )

        print()
        print("=" * 120)
        print("ECC FULL-PIPELINE SMOKE TEST")
        print("=" * 120)
        print("Dataset :", task["dataset"])
        print("Model   :", task["model"])
        print("Epochs  : 1")
        print("Output  :", smoke_root)
        print()

        run_dir = run_training(
            task
        )

        print()
        print("=" * 120)
        print("ECC SMOKE TEST PASSED")
        print("=" * 120)
        print("Run directory:", run_dir)
        print()

    except Exception:

        print()
        print("=" * 120)
        print("ECC SMOKE TEST FAILED")
        print("=" * 120)
        print()
        traceback.print_exc()
        print()
        print(
            "FULL 44-JOB SUBMISSION ABORTED because ECC "
            "cannot yet complete one training epoch."
        )
        print()

        raise

    finally:

        EPOCHS = original_epochs
        PATIENCE = original_patience

        if had_batch_size:
            BATCH_SIZE = original_batch_size

        globals()["task_result_root"] = (
            original_task_result_root
        )


def incomplete_task_ids() -> List[int]:
    missing = []

    for task in all_tasks():
        complete, _ = validated_task_result(
            task
        )

        if not complete:
            missing.append(
                task["task_id"]
            )

    return missing


def compact_ids(ids: Sequence[int]) -> str:
    ids = sorted(set(ids))
    if not ids:
        return ""

    pieces = []
    start = prev = ids[0]

    for value in ids[1:]:
        if value == prev + 1:
            prev = value
            continue

        pieces.append(str(start) if start == prev else f"{start}-{prev}")
        start = prev = value

    pieces.append(str(start) if start == prev else f"{start}-{prev}")
    return ",".join(pieces)


def _require_python(path: str, label: str) -> str:
    p = Path(path)

    if not p.is_file():
        raise SystemExit(
            f"[ERROR] {label} Python interpreter does not exist:\\n"
            f"  {path}\\n"
            "Create that environment first or pass the correct path."
        )

    return str(
        p.resolve()
    )


def _routed_resume_worker_script(
    author_python: str,
    gnn_python: str,
) -> str:
    """
    One Slurm array, two isolated interpreters.

    The task IDs for author PhyloCNN are deterministic because every dataset
    contributes the three author models first.
    """
    author_ids = [
        task["task_id"]
        for task in all_tasks()
        if task["model"] in AUTHOR_MODELS
    ]

    author_case = "|".join(
        str(x)
        for x in author_ids
    )

    return (
        'echo "============================================================"; '
        'echo "EXPERIMENT 1 ROUTED RESUME"; '
        'echo "JOB       : $SLURM_JOB_ID"; '
        'echo "ARRAY TASK: $SLURM_ARRAY_TASK_ID"; '
        'echo "HOST      : $(hostname)"; '
        'echo "START     : $(date)"; '
        'echo "============================================================"; '
        'nvidia-smi || true; '
        f'case "$SLURM_ARRAY_TASK_ID" in '
        f'{author_case}) '
        f'PYTHON={shlex.quote(author_python)}; '
        'FAMILY=AUTHOR_PHYLOCNN ;; '
        '*) '
        f'PYTHON={shlex.quote(gnn_python)}; '
        'FAMILY=PHYLOGNN ;; '
        'esac; '
        'echo "FAMILY    : $FAMILY"; '
        'echo "PYTHON    : $PYTHON"; '
        f'exec "$PYTHON" -u '
        f'{shlex.quote(str(Path(__file__).resolve()))} '
        '--worker "$SLURM_ARRAY_TASK_ID"'
    )


def submit(args, resume=False) -> None:
    apply_runtime_environment()
    ensure_project_layout()
    activate_repo_source()

    # -------------------------------------------------------------------------
    # FRESH RUN
    #
    # Never inherit DONE / FAILED markers from a previous array.
    # Keep expensive prepared caches.
    # -------------------------------------------------------------------------

    if not resume:

        reset_fresh_submission_state()

        print()
        print("=" * 120)
        print("FAST SUBMISSION MODE")
        print("=" * 120)
        print("[CACHE] Reusing previously prepared graph/PhyloCNN caches.")
        print("[SKIP]  Full inspect/prepare preflight.")
        print("[INFO]  Run --preflight manually only after changing data/source.")
        print()

        # One real epoch is enough to ensure ECC works before
        # launching the complete benchmark.
        print(
            "[GPU] ECC will be tested inside its Ascher GPU array task."
        )

    write_task_map()
    LOGS.mkdir(parents=True, exist_ok=True)
    RESULTS.mkdir(parents=True, exist_ok=True)

    ids = incomplete_task_ids() if resume else list(range(len(all_tasks())))
    if not ids:
        print("[OK] All 44 tasks are already complete.")
        return

    array_base = compact_ids(ids)

    if (
        args.max_parallel
        and
        int(args.max_parallel) > 0
    ):
        array = (
            f"{array_base}%"
            f"{int(args.max_parallel)}"
        )
    else:
        array = array_base

    # Workers use exactly the Python interpreter that launched this script.
    # No `uv run`, no editable build, and no writes to ~/.cache.
    env_prefix = " ".join(
        [
            f"UV_CACHE_DIR={shlex.quote(str(LOCAL_UV_CACHE))}",
            f"UV_PROJECT_ENVIRONMENT={shlex.quote(str(LOCAL_UV_ENV))}",
            f"XDG_CACHE_HOME={shlex.quote(str(LOCAL_XDG_CACHE))}",
            f"TMPDIR={shlex.quote(str(LOCAL_TMP))}",
            f"MPLCONFIGDIR={shlex.quote(str(LOCAL_XDG_CACHE / 'matplotlib'))}",
            f"KERAS_HOME={shlex.quote(str(LOCAL_XDG_CACHE / 'keras'))}",
            f"PYTHONPATH={shlex.quote(os.pathsep.join((str(REPO / 'src'), str(SCRIPT_DIR))))}",
            "PYTHONUNBUFFERED=1",
            "TF_CPP_MIN_LOG_LEVEL=2",
            f"OMP_NUM_THREADS={int(args.cpus)}",
            f"TF_NUM_INTRAOP_THREADS={int(args.cpus)}",
            "TF_NUM_INTEROP_THREADS=1",
        ]
    )

    if resume:
        author_needed = any(
            get_task(task_id)["model"] in AUTHOR_MODELS
            for task_id in ids
        )

        gnn_needed = any(
            get_task(task_id)["model"] in OUR_MODELS
            for task_id in ids
        )

        author_python = args.author_python
        gnn_python = args.gnn_python

        if author_needed:
            author_python = _require_python(
                author_python,
                "AUTHOR PHYLOCNN",
            )

        if gnn_needed:
            gnn_python = _require_python(
                gnn_python,
                "PHYLOGNN",
            )

        worker_script = _routed_resume_worker_script(
            author_python=author_python,
            gnn_python=gnn_python,
        )

        print()
        print("=" * 120)
        print("ROUTED RESUME")
        print("=" * 120)
        print("Incomplete task IDs :", compact_ids(ids))
        print("Author Python       :", author_python if author_needed else "not needed")
        print("GNN Python          :", gnn_python if gnn_needed else "not needed")
        print("Already successful tasks will NOT be rerun.")
        print()

    else:
        worker_script = (
            'echo "============================================================"; '
            'echo "ASCHER GPU EXPERIMENT 1"; '
            'echo "JOB       : $SLURM_JOB_ID"; '
            'echo "ARRAY TASK: $SLURM_ARRAY_TASK_ID"; '
            'echo "HOST      : $(hostname)"; '
            'echo "START     : $(date)"; '
            'echo "============================================================"; '
            'nvidia-smi; '
            f'exec {shlex.quote(sys.executable)} -u '
            f'{shlex.quote(str(Path(__file__).resolve()))} '
            '--worker $SLURM_ARRAY_TASK_ID'
        )

    worker_command = (
        f"env {env_prefix} "
        "PYTHONUNBUFFERED=1 "
        "TF_CPP_MIN_LOG_LEVEL=1 "
        "bash -lc "
        f"{shlex.quote(worker_script)}"
    )


    cmd = [
        "sbatch",
        "--parsable",
        "--job-name", JOB_NAME,
        "--array", array,
        "--partition", args.partition,
        "--qos", args.qos,
        "--nodes", "1",
        "--ntasks", "1",
        "--cpus-per-task", str(args.cpus),
        "--mem", args.mem,
        "--time", args.time,
        "--chdir", str(SCRIPT_DIR),
        "--output", str(LOGS / "%x.%A_%a.out"),
        "--error", str(LOGS / "%x.%A_%a.err"),
    ]

    if args.gres:
        cmd += [
            "--gres",
            args.gres,
        ]

    cmd += ["--wrap", worker_command]

    print("=" * 120)
    print("SUBMIT STEP 3")
    print("=" * 120)
    print("Array tasks :", array)
    print("Task count  :", len(ids))
    print("Total design: 44 jobs = 4 datasets x 11 models")

    r = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        text=True,
        check=True,
    )
    job_id = r.stdout.strip().split(";")[0]

    submission = {
        "submitted": datetime.now().astimezone().isoformat(timespec="seconds"),
        "job_id": job_id,
        "array": array,
        "tasks": len(ids),
        "partition": args.partition,
        "qos": args.qos,
        "cpus": args.cpus,
        "mem": args.mem,
        "time": args.time,
        "gres": args.gres,
    }

    (STATE / "last_submission.json").write_text(
        json.dumps(submission, indent=2) + "\n"
    )

    print("Submitted job :", job_id)
    print()
    print("Progress:")
    print("  python Step3_Experiment1_LimitedTest.py --status")


def cancel() -> None:
    user = os.environ.get("USER")
    if not user:
        raise SystemExit("[ERROR] USER environment variable not set")

    r = subprocess.run(
        ["squeue", "-h", "-u", user, "-n", JOB_NAME, "-o", "%A"],
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )

    ids = sorted(
        set(
            line.strip().split("_")[0]
            for line in r.stdout.splitlines()
            if line.strip()
        )
    )

    if not ids:
        print("[OK] No active Step 3 jobs.")
        return

    print("Cancelling:", " ".join(ids))
    subprocess.run(["scancel", *ids], check=False)


# =============================================================================
# CLI
# =============================================================================

def main():
    apply_runtime_environment()
    ensure_project_layout()
    activate_repo_source()

    p = argparse.ArgumentParser()

    g = p.add_mutually_exclusive_group(required=False)
    g.add_argument("--plan", action="store_true")
    g.add_argument("--preflight", action="store_true")
    g.add_argument("--submit", action="store_true")
    g.add_argument("--resume", action="store_true")
    g.add_argument("--status", action="store_true")
    g.add_argument(
        "--watch",
        action="store_true",
        help="Continuously refresh live epoch/loss/time progress.",
    )
    g.add_argument("--aggregate", action="store_true")
    g.add_argument("--cancel", action="store_true")
    g.add_argument("--worker", type=int)

    p.add_argument("--workers", type=int, default=8)

    p.add_argument(
        "--max-parallel",
        type=int,
        default=8,
        help=(
            "Maximum simultaneous Slurm array tasks. "
            "All 44 jobs are submitted, but only this many run concurrently. "
            "Default: 8."
        ),
    )
    p.add_argument(
        "--watch-seconds",
        type=int,
        default=20,
        help="Refresh interval for --watch (default: 20 seconds).",
    )
    p.add_argument("--partition", default="ascher")
    p.add_argument(
        "--qos",
        default="gpu",
        help="Slurm QoS. Ascher GPU jobs use gpu.",
    )
    p.add_argument("--cpus", type=int, default=4)
    p.add_argument("--mem", default="90G")
    p.add_argument("--time", default="12:00:00")
    p.add_argument(
        "--gres",
        default="gpu:1",
        help="Optional Slurm GRES, e.g. gpu:1. Default is CPU/no GRES.",
    )

    p.add_argument(
        "--author-python",
        default=DEFAULT_AUTHOR_PYTHON,
        help=(
            "Python interpreter for author PhyloCNN tasks during --resume. "
            "Default: $PHYLOCNN_AUTHOR_PYTHON or the phylocnn-author env path."
        ),
    )

    p.add_argument(
        "--gnn-python",
        default=DEFAULT_GNN_PYTHON,
        help=(
            "Python interpreter for our GNN tasks during --resume. "
            "Default: the Python launching this controller."
        ),
    )

    args = p.parse_args()

    if not any((
        args.plan, args.preflight, args.submit, args.resume, args.status,
        args.watch, args.aggregate, args.cancel, args.worker is not None,
    )):
        print("=" * 120)
        print("PHYLOGNN EXPERIMENT 1 — SELF-CONTAINED CONTROLLER")
        print("=" * 120)
        print("Python      :", sys.executable)
        print("Working dir :", SCRIPT_DIR)
        print("Source      :", REPO / "src")
        print("Results     :", RESULTS)
        print("UV cache    :", LOCAL_UV_CACHE)
        print("Home uv     : NOT USED")
        print()
        print("Commands: --plan --submit --status --watch --resume --aggregate --cancel")
        print()
        status()
        return

    if args.plan:
        plan()
    elif args.preflight:
        preflight(args.workers)
    elif args.submit:
        submit(args, resume=False)
    elif args.resume:
        submit(args, resume=True)
    elif args.status:
        status()
    elif args.watch:
        watch_status(
            args.watch_seconds
        )
    elif args.aggregate:
        aggregate()
    elif args.cancel:
        cancel()
    elif args.worker is not None:
        worker(args.worker)


if __name__ == "__main__":
    main()
